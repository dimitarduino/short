GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# YouTube Data API OAuth (Web client)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Must match Google Cloud Authorized redirect URIs exactly (localhost ≠ 127.0.0.1)
YOUTUBE_REDIRECT_URI=http://localhost:8000/oauth2callback

# VPS / bot-check: Netscape cookies.txt from a throwaway Google account (optional locally)
# Export while logged into youtube.com, then place on the server:
#   data/youtube_cookies.txt
# Or set an absolute path:
# YOUTUBE_COOKIES_FILE=/var/www/shorts-gen/data/youtube_cookies.txt

# X OAuth 2.0 (PKCE). Create an app at https://developer.x.com/
# Callback URL must match exactly:
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://localhost:8000/auth/x/callback
# Optional aliases (same as client id/secret) or pre-minted user token:
# X_API_KEY=
# X_API_SECRET=
# X_ACCESS_TOKEN=

# TikTok Login Kit + Content Posting API
# Create app at https://developers.tiktok.com/ — enable Login Kit + Content Posting API
# TikTok REQUIRES https:// redirect URIs (http://localhost is rejected).
# Use ngrok:  ngrok http 8000
# Then set redirect to: https://YOUR_SUBDOMAIN.ngrok-free.app/auth/tiktok/callback
# Register that EXACT URI under Login Kit → Redirect URI.
# TikTok: inbox = draft in TikTok app (recommended for unaudited apps)
TIKTOK_POST_MODE=inbox
TIKTOK_PRIVACY_LEVEL=SELF_ONLY
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://YOUR_SUBDOMAIN.ngrok-free.app/auth/tiktok/callback
